{
  "version": 8,
  "name": "Travel Video OpenFreeMap Clean",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "paint": {
        "background-color": "#eef2eb"
      }
    },
    {
      "id": "landcover-wood",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "landcover",
      "filter": ["==", "class", "wood"],
      "paint": {
        "fill-color": "#dce8d6",
        "fill-opacity": 0.65
      }
    },
    {
      "id": "landuse-park",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "park",
      "paint": {
        "fill-color": "#d8e8d2",
        "fill-opacity": 0.6
      }
    },
    {
      "id": "water",
      "type": "fill",
      "source": "openmaptiles",
      "source-layer": "water",
      "paint": {
        "fill-color": "#a8CBE8"
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "waterway",
      "paint": {
        "line-color": "#a8CBE8",
        "line-width": 1.2
      }
    },
    {
      "id": "boundary-country",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["<=", "admin_level", 2],
      "paint": {
        "line-color": "#94a3b8",
        "line-width": 1.4,
        "line-dasharray": [3, 2]
      }
    },
    {
      "id": "boundary-state",
      "type": "line",
      "source": "openmaptiles",
      "source-layer": "boundary",
      "filter": ["all", [">", "admin_level", 2], ["<=", "admin_level", 4]],
      "paint": {
        "line-color": "#cbd5e1",
        "line-width": 0.9,
        "line-dasharray": [2, 2]
      }
    },
    {
      "id": "place-city",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["in", "class", "city", "town", "state", "province"],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:zh-Hant"],
          ["get", "name:zh-TW"],
          ["get", "name:zh"],
          ["get", "name"],
          ["get", "name:en"]
        ],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          4,
          11,
          8,
          14,
          12,
          17
        ],
        "text-max-width": 8
      },
      "paint": {
        "text-color": "#334155",
        "text-halo-color": "rgba(255,255,255,0.85)",
        "text-halo-width": 1.6
      }
    },
    {
      "id": "place-country",
      "type": "symbol",
      "source": "openmaptiles",
      "source-layer": "place",
      "filter": ["==", "class", "country"],
      "layout": {
        "text-field": [
          "coalesce",
          ["get", "name:zh-Hant"],
          ["get", "name:zh-TW"],
          ["get", "name:zh"],
          ["get", "name"],
          ["get", "name:en"]
        ],
        "text-font": ["Noto Sans Bold"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          2,
          12,
          6,
          16
        ]
      },
      "paint": {
        "text-color": "#475569",
        "text-halo-color": "rgba(255,255,255,0.9)",
        "text-halo-width": 2
      }
    }
  ]
}
